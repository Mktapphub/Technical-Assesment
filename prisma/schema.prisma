datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EnrolmentStatus {
  Enrolled
  Deferred
  Withdrawn
  Completed
}

enum GradeClassification {
  Distinction
  Merit
  Pass
  Fail
}

model Programme {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  department    String
  feeAmount     Float
  durationYears Int       @default(3)
  students      Student[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Student {
  id              String          @id @default(cuid())
  studentId       String          @unique // e.g. SMS-2025-0001
  fullName        String
  email           String          @unique
  dateOfBirth     DateTime
  academicYear    String          @default("2024/25")
  enrolmentStatus EnrolmentStatus @default(Enrolled)
  feeDueDate      DateTime?       // Standard fee deadline date for calculating overdue balances
  programmeId     String
  programme       Programme       @relation(fields: [programmeId], references: [id])
  password        String          @default("student123")
  payments        Payment[]
  submissions     Submission[]
  grades          Grade[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([programmeId])
  @@index([enrolmentStatus])
}

model Payment {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount          Float
  paymentDate     DateTime @default(now())
  referenceNumber String   @unique // e.g. PAY-2025-0812
  paymentMethod   String   @default("Bank Transfer") // Bank Transfer, Card, Cheque, Scholarship
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
  @@index([paymentDate])
}

model Assessment {
  id           String       @id @default(cuid())
  title        String
  moduleName   String
  moduleCode   String
  academicYear String       @default("2024/25")
  deadline     DateTime
  weighting    Int          @default(100)
  maxScore     Int          @default(100)
  description  String?
  submissions  Submission[]
  grades       Grade[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([moduleCode])
}

model Submission {
  id                String     @id @default(cuid())
  assessmentId      String
  assessment        Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileName          String
  fileType          String     // application/pdf or application/vnd.openxmlformats-officedocument.wordprocessingml.document
  fileSize          Int?
  fileContentBase64 String?
  submittedAt       DateTime   @default(now())
  isLate            Boolean    @default(false)
  version           Int        @default(1)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
}

model Grade {
  id             String              @id @default(cuid())
  assessmentId   String
  assessment     Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  numericScore   Float               // 0 - 100
  classification GradeClassification
  isPublished    Boolean             @default(false)
  feedback       String?
  gradedBy       String              @default("Registry Examination Board")
  gradedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
  @@index([isPublished])
}
