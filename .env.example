# PostgreSQL connection string used by the app at runtime.
# If your provider supports connection pooling (e.g. Supabase, Neon),
# use the pooled connection string here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Direct (non-pooled) connection string, used only for running Prisma
# migrations. If your provider doesn't offer pooling, this can be the
# same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"
